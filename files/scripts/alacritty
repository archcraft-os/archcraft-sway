#!/usr/bin/env bash

## Copyright (C) 2020-2026 Aditya Shakya <adi1090x@gmail.com>
##
## Alacritty ------------------------------------------------

# Directory
DIR="$HOME/.config/sway"
CONFIG="$DIR/alacritty/alacritty.toml"

# Virtualbox workarounds
cmd=(alacritty)
if [[ "$(systemd-detect-virt)" == "oracle" ]]; then
    cmd=(env LIBGL_ALWAYS_SOFTWARE=1 alacritty)
fi

if [[ "$1" == '-f' ]]; then
	"${cmd[@]}" \
		--class 'alacritty-float,alacritty-float' \
		--config-file "$CONFIG"
elif [[ "$1" == '-F' ]]; then
	"${cmd[@]}" \
		--class 'alacritty-fullscreen,alacritty-fullscreen' \
		--config-file "$CONFIG" \
		-o window.startup_mode="'Fullscreen'" \
		window.padding.x=30 window.padding.y=30 \
		window.opacity=0.95 \
		font.size=14
else
	"${cmd[@]}" --config-file "$CONFIG" ${@}
fi
