#fi

## All Virtual machines workarounds (is cause issues)
#if systemd-detect-virt --quiet; then
#    export WLR_NO_HARDWARE_CURSORS=1
#fi

## Virtualbox workarounds
if [[ "$(systemd-detect-virt)" == "oracle" ]]; then
    export WLR_NO_HARDWARE_CURSORS=1
fi

## Start Sway
# Small delay to allow the session environment to settle
sleep 0.5

if lspci -k | grep -P 'VGA|3D|Display' | grep -qw NVIDIA &&
   lsmod | grep -qw nvidia; then
    exec /usr/bin/archcraft-session sway --unsupported-gpu
else
    exec /usr/bin/archcraft-session sway
fi
